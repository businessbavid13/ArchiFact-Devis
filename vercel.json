{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/auth/hooks/send-email",
      "destination": "/api/index.ts"
    },
    {
      "source": "/webhooks/geniuspay",
      "destination": "/api/index.ts"
    },
    {
      "source": "/health",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/ai/:path*",
      "destination": "/api/index.ts"
    }
  ]
}
