import express, { Request, Response, NextFunction } from 'express';
import cors from 'cors';
import helmet from 'helmet';
// Correct import based on what we found in the exports
import { GoogleGenAI } from '@google/genai';
import 'dotenv/config';

const app = express();
const port = process.env.PORT || 5000;

// Middleware
app.use(helmet());
app.use(cors());
app.use(express.json({ limit: '10mb' }));
app.use(express.urlencoded({ extended: true, limit: '10mb' }));

// Initialize Gemini AI
const genai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY || '' });

// Health check endpoint
app.get('/health', (req: Request, res: Response) => {
  res.status(200).json({ status: 'OK', timestamp: new Date().toISOString() });
});

// AI Analysis Endpoints

// Analyze image for document extraction
app.post('/ai/analyze-image', async (req: Request, res: Response) => {
  try {
    if (!process.env.GEMINI_API_KEY) {
      return res.status(500).json({ error: 'Gemini API key not configured' });
    }

    const { imageBase64, mimeType } = req.body;
    
    if (!imageBase64 || !mimeType) {
      return res.status(400).json({ error: 'Image data and mimeType are required' });
    }

    // TODO: Implement actual Gemini Vision API call
    // For now, return a mock response to maintain compatibility
    res.status(200).json({
      success: true,
      data: {
        documentType: 'quote',
        extractedText: 'Mock extracted text from image',
        confidence: 0.95
      }
    });
  } catch (error) {
    console.error('Error in analyze-image:', error);
    res.status(500).json({ error: 'Internal server error' });
  }
});

// Transcribe audio to text
app.post('/ai/transcribe-audio', async (req: Request, res: Response) => {
  try {
    if (!process.env.GEMINI_API_KEY) {
      return res.status(500).json({ error: 'Gemini API key not configured' });
    }

    const { audioBase64, mimeType } = req.body;
    
    if (!audioBase64 || !mimeType) {
      return res.status(400).json({ error: 'Audio data and mimeType are required' });
    }

    // TODO: Implement actual Gemini Audio API call
    res.status(200).json({
      success: true,
      data: {
        text: 'Mock transcription from audio',
        confidence: 0.9,
        language: 'fr-FR'
      }
    });
  } catch (error) {
    console.error('Error in transcribe-audio:', error);
    res.status(500).json({ error: 'Internal server error' });
  }
});

// Parse business command from text
app.post('/ai/parse-command', async (req: Request, res: Response) => {
  try {
    if (!process.env.GEMINI_API_KEY) {
      return res.status(500).json({ error: 'Gemini API key not configured' });
    }

    const { text } = req.body;
    
    if (!text) {
      return res.status(400).json({ error: 'Text is required' });
    }

    // TODO: Implement actual Gemini Text API call for command parsing
    res.status(200).json({
      success: true,
      data: {
        action: 'add_item',
        items: [
          {
            description: 'Sac de ciment',
            quantity: 5,
            unit: 'sac',
            unitPrice: 6500,
            total: 32500
          }
        ]
      }
    });
  } catch (error) {
    console.error('Error in parse-command:', error);
    res.status(500).json({ error: 'Internal server error' });
  }
});

// Error handling middleware
app.use((err: Error, req: Request, res: Response, next: NextFunction) => {
  console.error(err.stack);
  res.status(500).json({ error: 'Internal server error' });
});

app.listen(port, () => {
  console.log(`AI Service running on port ${port}`);
});

export default app;
